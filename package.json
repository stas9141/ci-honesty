{
  "name": "ci-honesty",
  "version": "0.1.0",
  "description": "Finds tests that cannot fail.",
  "license": "MIT",
  "author": "Stas Dobromilskyi",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stas9141/ci-honesty.git"
  },
  "keywords": [
    "testing",
    "playwright",
    "static-analysis",
    "test-quality",
    "flaky-tests"
  ],
  "bin": {
    "ci-honesty": "bin/ci-honesty.js"
  },
  "scripts": {
    "selftest": "node selftest.js",
    "test": "node selftest.js",
    "verify:jest": "jest verification/jest.test.js",
    "verify:playwright": "playwright test --config verification/playwright.config.ts",
    "verify": "npm run verify:jest && npm run verify:playwright"
  },
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "jest": "^29.7.0"
  }
}
